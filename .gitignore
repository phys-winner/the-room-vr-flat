/out/
/app/build/
/app/dist/
/work/tmp/
/work/logs/
/work/ida/
/work/il2cppdumper/
/work/tool-cache/
/work/native/build/
**/__pycache__/
# Secrets
/work/keys/
/signing/
*.jks
*.keystore
*.pk8
