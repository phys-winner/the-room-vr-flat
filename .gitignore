# No game files in Git: the original APK, its decode and the canonical app/ tree are recreated locally from the
# player's own APK (work/tools/prepare_app.py + patches/app.patch)
/*.apk
/original/
/decoded_original/
/app/
# Build outputs, test evidence and logs, analysis output, caches
/out/
/pub/
/work/backups/
/work/input_selfcheck_*
/work/evidence/
/work/logs/
/work/removed/
/work/tmp/
/work/tmp*/
/work/ida/
/work/il2cppdumper/
/work/loc/
/work/tool-cache/
/work/native/build/
/work/saves_backup/
/work/manifests/cleanup_*.json
/work/manifests/scene_mechanics.txt
/work/tools/mtinject
/work/tools/mtinject_ap/*.dex
**/__pycache__/
# Machine-specific settings: tool paths, device serials
/work/local.json
# Secrets
/work/keys/
/signing/
*.jks
*.keystore
*.pk8
*.pem
*.crt
*.der
*.p12
*.pfx
.env
